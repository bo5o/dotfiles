(( $+functions[_sem_commands] )) ||
_sem_commands() {
    local commands; commands=(
'diff:Show semantic diff of changes (supports git diff syntax). Untracked files are excluded, matching git behavior' \
'impact:Show impact of changing an entity (deps, dependents, transitive impact, tests)' \
'find:Find entity definitions by name — answers from the mmap query index when one exists (cold-process, <10ms on a large repo); falls back to a fresh build otherwise, which then leaves an index for next time' \
'callers:Show direct callers of an entity (who calls/references it) — the index'\''s reverse postings, same freshness/fallback discipline as \`find\`' \
'refs:Show direct refs of an entity (what it calls/references) — the index'\''s forward postings, same freshness/fallback discipline as \`find\`' \
'grep:Search file text — rg-compatible \`file\:line\:text\` output, served from the mmap query index'\''s trigram postings when one exists (cold process, target <50ms on a large repo); falls back to a plain scan otherwise. Pattern is always a regex (same default as rg without \`-F\`); patterns with no usable trigram (e.g. \`-i\`, short literals, unconstrained alternation) degrade to an honest full scan rather than a wrong answer' \
'graph:Show the full entity dependency graph' \
'blame:Show semantic blame — who last modified each entity' \
'hook:Internal plumbing for agent-harness hooks (hidden)' \
'log:Show evolution of an entity through git history, or, with no entity, the repo'\''s history analytics\: hotspots and co-change pairs' \
'entities:List entities under one or more file or directory paths' \
'context:Show token-budgeted context for an entity' \
'stats:Show lifetime diff statistics' \
'mcp:Start the MCP server (stdin/stdout transport)' \
'setup:Replace \`git diff\` with \`sem diff\` globally' \
'unsetup:Restore default \`git diff\` behavior' \
'login:Log in to sem cloud' \
'logout:Log out of sem cloud' \
'whoami:Show current sem cloud identity' \
'cloud:Manage cloud acceleration for a repo (off until you enable it)' \
'review:Attach an agent to a sem-cloud code review' \
'telemetry:Control anonymous usage telemetry (local by default — nothing uploaded)' \
'xref:Show cross-repo dependencies across your indexed repos (requires sem login)' \
'repos:Show where your code is stored\: repos indexed on your cloud account and local entity caches' \
'update:Update sem to the latest released version' \
'completions:Generate shell completions' \
'__telemetry-flush:Flush spooled telemetry (internal; spawned in the background)' \
'__update-check:Refresh the cached latest-version info (internal; spawned in the background)' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'sem commands' commands "$@"
}
